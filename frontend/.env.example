# Copy to .env. Only VITE_* variables reach the browser — never put secrets here.
VITE_API_URL=http://localhost:5000/api

# Optional: RPC URLs offered to MetaMask when it needs to add a network.
# Leave blank to use the free public endpoints in src/config/networks.js.
# Do NOT put RPC URLs containing private API keys here: they would be public.
VITE_SEPOLIA_RPC_URL=
VITE_BASE_SEPOLIA_RPC_URL=
