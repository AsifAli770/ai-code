# Copy this file to .env and fill in real values. Never commit .env.

# ---- Server ----
NODE_ENV=development
PORT=5000
# Comma-separated list of origins allowed to call the API (the Vite dev server by default)
CORS_ORIGINS=http://localhost:5173

# ---- Database ----
# MongoDB Atlas connection string, including the database name, e.g.
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ai_nft_marketplace?retryWrites=true&w=majority
MONGODB_URI=

# ---- Auth ----
# Use a long random string (at least 32 chars). Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=12

# ---- Wallet verification ----
# The frontend origin shown inside the message users sign (defaults to the first CORS origin).
APP_ORIGIN=http://localhost:5173
# How long a wallet-link nonce stays valid, in seconds.
WALLET_NONCE_TTL_SECONDS=300

# ---- Uploads ----
# Folder for uploaded artwork (relative to the backend folder). Ignored by git.
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# ---- AI ----
# Text suggestions (title, description, traits, collection name). "groq" or "none".
AI_TEXT_PROVIDER=groq
# Free key from https://console.groq.com/keys (stay on the free plan; don't add billing).
# Server-side only. Never put this key in the frontend.
GROQ_API_KEY=
# openai/gpt-oss-20b supports schema-checked JSON. Others: openai/gpt-oss-120b,
# llama-3.3-70b-versatile, llama-3.1-8b-instant (plain JSON mode).
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_MS=30000
# Image generation. "none" = upload only (no local GPU). Future: "comfyui".
AI_IMAGE_PROVIDER=none

# ---- Admin seeder (npm run seed:admin) ----
# Password: 12–72 chars with at least one letter and one number.
ADMIN_NAME=Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Networks ----
# Optional in Phase 2. Leave blank to use the public RPCs in src/config/networks.js.
SEPOLIA_RPC_URL=
BASE_SEPOLIA_RPC_URL=

# ---- IPFS (Pinata) ----
# Free account: https://app.pinata.cloud -> API Keys -> New Key -> copy the JWT.
# Server-side only. Don't add billing.
PINATA_JWT=
# Gateway used to display ipfs:// content in the browser (your free dedicated
# gateway, e.g. https://<name>.mypinata.cloud/ipfs, is more reliable).
IPFS_GATEWAY_URL=https://ipfs.io/ipfs
IPFS_TIMEOUT_MS=60000

# ---- Later phases ----
SEPOLIA_NFT_CONTRACT=
BASE_SEPOLIA_NFT_CONTRACT=
SEPOLIA_MARKETPLACE_CONTRACT=
BASE_SEPOLIA_MARKETPLACE_CONTRACT=
