{
  "info": {
    "name": "AI NFT Marketplace — Auth, Users & Wallet",
    "description": "Import into Postman. Register or Login automatically saves the JWT into the {{token}} collection variable.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api" },
    { "key": "token", "value": "" },
    { "key": "walletNonce", "value": "" },
    { "key": "artworkId", "value": "" }
  ],
  "item": [
    {
      "name": "Health check",
      "request": { "method": "GET", "url": "{{baseUrl}}/health" }
    },
    {
      "name": "Register",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const body = pm.response.json();",
              "if (body.data && body.data.token) pm.collectionVariables.set('token', body.data.token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Alice Doe\",\n  \"email\": \"alice@example.com\",\n  \"password\": \"secret123\"\n}"
        }
      }
    },
    {
      "name": "Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const body = pm.response.json();",
              "if (body.data && body.data.token) pm.collectionVariables.set('token', body.data.token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"secret123\"\n}"
        }
      }
    },
    {
      "name": "Current user (me)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/auth/me"
      }
    },
    {
      "name": "Get my profile",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/users/me"
      }
    },
    {
      "name": "List supported networks",
      "request": { "method": "GET", "url": "{{baseUrl}}/networks" }
    },
    {
      "name": "Wallet: request nonce",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const body = pm.response.json();",
              "if (body.data && body.data.nonce) pm.collectionVariables.set('walletNonce', body.data.nonce);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{baseUrl}}/wallet/nonce",
        "description": "Returns { nonce, message, expiresAt }. Sign `message` with the wallet (personal_sign), then call Verify within the TTL. Postman cannot sign: use the app's dashboard, or the automated tests (npm test).",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"address\": \"0xYourWalletAddress\",\n  \"chainId\": 11155111\n}"
        }
      }
    },
    {
      "name": "Wallet: verify signature",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{baseUrl}}/wallet/verify",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nonce\": \"{{walletNonce}}\",\n  \"signature\": \"0x<130 hex chars from MetaMask>\"\n}"
        }
      }
    },
    {
      "name": "Wallet: unlink",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/wallet"
      }
    },
    {
      "name": "AI: status",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/ai/status"
      }
    },
    {
      "name": "AI: suggest details (Groq)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{baseUrl}}/ai/suggest",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"prompt\": \"a futuristic city with neon lights at night\",\n  \"style\": \"cyberpunk\"\n}"
        }
      }
    },
    {
      "name": "Artwork: upload",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const body = pm.response.json();",
              "if (body.data && body.data.generation) pm.collectionVariables.set('artworkId', body.data.generation.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/ai/generations",
        "description": "multipart/form-data. In the Body tab, choose a real image file for the `image` field.",
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "image", "type": "file", "src": [] },
            { "key": "name", "value": "Neon Skyline", "type": "text" },
            { "key": "description", "value": "A glowing city at night.", "type": "text" },
            { "key": "collectionName", "value": "Electric Dreams", "type": "text" },
            { "key": "style", "value": "cyberpunk", "type": "text" },
            { "key": "attributes", "value": "[{\"trait_type\":\"Mood\",\"value\":\"Mysterious\"}]", "type": "text" }
          ]
        }
      }
    },
    {
      "name": "Artwork: list mine",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/ai/generations?page=1&limit=12"
      }
    },
    {
      "name": "Artwork: get one",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/ai/generations/{{artworkId}}"
      }
    },
    {
      "name": "Artwork: update details",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{baseUrl}}/ai/generations/{{artworkId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Neon Skyline II\",\n  \"attributes\": [{ \"trait_type\": \"Rarity\", \"value\": \"Rare\" }]\n}"
        }
      }
    },
    {
      "name": "IPFS: status",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/ai/ipfs/status"
      }
    },
    {
      "name": "IPFS: publish / retry artwork",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/ai/generations/{{artworkId}}/ipfs",
        "description": "Uploads image then metadata to IPFS via Pinata. Idempotent and resumable: call again to retry after a failure; completed steps are skipped and nothing is uploaded twice."
      }
    },
    {
      "name": "Artwork: delete",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/ai/generations/{{artworkId}}"
      }
    },
    {
      "name": "Update my profile",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{baseUrl}}/users/me",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Alice Updated\",\n  \"bio\": \"Digital artist exploring AI-generated worlds.\"\n}"
        }
      }
    }
  ]
}
